# ── Dependencies ─────────────────────────────────────────────
/vendor
/node_modules
/auth.json

# ── Environment / secrets ───────────────────────────────────
.env
.env.*
!.env.example
!.env.testing
Homestead.json
Homestead.yaml

# ── Runtime storage ─────────────────────────────────────────
/storage/*.key
/storage/pail
/storage/logs/*
!/storage/logs/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
!/storage/framework/cache/data/
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/app/private/*
!/storage/app/private/.gitignore
/storage/app/public/*
!/storage/app/public/.gitignore

# First-run installer state + lock (server-specific, never committed)
/storage/app/install/
/storage/app/installed

# ── Framework caches ────────────────────────────────────────
/bootstrap/cache/*
!/bootstrap/cache/.gitignore
/public/build
/public/hot
/public/storage
/public/fonts-manifest.dev.json

# ── Tooling / editor artifacts ──────────────────────────────
/.phpunit.cache
.phpunit.result.cache
.phpactor.json
_ide_helper.php
_ide_helper_models.php
.php-cs-fixer.cache
/.idea
/.vscode
/.zed
/.nova
/.fleet
/.cursor/
/.codex
/.claude
/.windsurf

# ── OS noise ────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log

# ── Debug / scratch files (do not commit) ───────────────────
/_render*.php
/tinker_tmp.php
/probe.php
/verify_db.php
/fix_constraint.php
/__tmp_*.php
/scripts/generate-test-pdfs.php
/scripts/compare-client-types.php
/scripts/measure-blocks.py
/scripts/pdf-to-png.*
/storage/app/test-pdfs/
/storage/app/test-*
