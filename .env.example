# ============================================================================
#  Fresh deployment
#  ---------------------------------------------------------------------------
#  1. cp .env.example .env
#  2. composer install --no-dev --optimize-autoloader
#  3. point the web server document root at   <project>/public
#  4. make storage/ and bootstrap/cache/ writable
#  5. open the site in a browser — the installation wizard opens automatically
#     and fills in APP_KEY, the DB_* values and APP_URL for you.
#
#  You normally do NOT need to edit anything below by hand.
#  See DEPLOY_NEW_SERVER.md for the full checklist.
# ============================================================================

APP_NAME="Management App"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Database ────────────────────────────────────────────────────────────────
# Left blank on purpose — the web installer writes these after testing the
# connection. MySQL / MariaDB is the supported default for this application.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ── Session / cache / queue ────────────────────────────────────────────────
# The installer itself always uses a file session so it can run before the
# database exists; these become active once installation is finished.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ── Mail ──────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Security ──────────────────────────────────────────────────────────────
CSP_ENABLED=true
CSP_ENFORCE=true

# Break-glass owner access is disabled until you set a token explicitly.
EMERGENCY_ACCESS_ENABLED=false
# EMERGENCY_ACCESS_TOKEN=
# EMERGENCY_OWNER_EMAIL=

# WooCommerce webhook (only if you use the storefront integration)
# WC_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"
